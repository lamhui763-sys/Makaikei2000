<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>旅遊計劃詳情 - 旅遊易</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { 
      font-family: 'Noto Sans TC', sans-serif; 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      color: #2d3748;
    }
    
    .container { 
      max-width: 1200px; 
      margin: 0 auto; 
      padding: 20px; 
    }
    
    .header {
      text-align: center;
      color: white;
      margin-bottom: 30px;
      padding: 30px 0;
    }
    
    .header h1 { 
      font-size: 2.5rem; 
      font-weight: 700;
      margin-bottom: 10px;
    }
    
    .card { 
      background: rgba(255,255,255,0.95); 
      border-radius: 15px; 
      padding: 30px; 
      margin-bottom: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      backdrop-filter: blur(10px);
    }
    
    .status {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 0.9rem;
    }
    
    .status.pending { background: #fef5e7; color: #d69e2e; }
    .status.completed { background: #f0fff4; color: #38a169; }
    .status.failed { background: #fed7d7; color: #e53e3e; }
    .status.expired { background: #e2e8f0; color: #718096; }
    
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    
    .section-title {
      color: #4a5568;
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }
    
    .info-item {
      background: #f7fafc;
      padding: 15px;
      border-radius: 10px;
      border-left: 4px solid #667eea;
    }
    
    .info-label {
      font-weight: 600;
      color: #4a5568;
      font-size: 0.9rem;
      margin-bottom: 5px;
    }
    
    .info-value {
      color: #2d3748;
      font-size: 1.1rem;
    }
    
    .flight-item, .hotel-item {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 15px;
      transition: all 0.3s ease;
    }
    
    .flight-item:hover, .hotel-item:hover {
      box-shadow: 0 8px 25px rgba(0,0,0,0.1);
      transform: translateY(-2px);
    }
    
    .price {
      color: #e53e3e;
      font-weight: bold;
      font-size: 1.3rem;
    }
    
    .rating {
      color: #fbb040;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .btn {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
    }
    
    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    
    .btn-secondary {
      background: #e2e8f0;
      color: #4a5568;
    }
    
    .btn-secondary:hover {
      background: #cbd5e0;
    }
    
    .no-data {
      text-align: center;
      color: #718096;
      padding: 40px;
      font-style: italic;
    }
    
    .travel-guide {
      white-space: pre-line;
      line-height: 1.8;
      color: #4a5568;
    }
    
    @media (max-width: 768px) {
      .container { padding: 15px; }
      .header h1 { font-size: 2rem; }
      .card { padding: 20px; }
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><i class="fas fa-map-marked-alt"></i> 旅遊計劃詳情</h1>
      <p>編號：#<%= trip.id %></p>
    </div>

    <!-- 基本信息 -->
    <div class="card">
      <div class="section-title">
        <i class="fas fa-info-circle"></i>
        基本信息
      </div>
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">姓名</div>
          <div class="info-value"><%= trip.name %></div>
        </div>
        <div class="info-item">
          <div class="info-label">目的地</div>
          <div class="info-value"><%= trip.destination %></div>
        </div>
        <div class="info-item">
          <div class="info-label">出發日期</div>
          <div class="info-value"><%= moment(trip.start_date).format('YYYY年MM月DD日') %></div>
        </div>
        <div class="info-item">
          <div class="info-label">旅行天數</div>
          <div class="info-value"><%= trip.duration %>天</div>
        </div>
        <div class="info-item">
          <div class="info-label">旅行人數</div>
          <div class="info-value"><%= trip.travelers || 1 %>人</div>
        </div>
        <div class="info-item">
          <div class="info-label">狀態</div>
          <div class="info-value">
            <span class="status <%= trip.status %>">
              <% if (trip.status === 'pending') { %>
                <i class="fas fa-clock"></i> 等待處理
              <% } else if (trip.status === 'completed') { %>
                <i class="fas fa-check"></i> 已完成
              <% } else if (trip.status === 'failed') { %>
                <i class="fas fa-times"></i> 處理失敗
              <% } else { %>
                <i class="fas fa-ban"></i> 已過期
              <% } %>
            </span>
          </div>
        </div>
      </div>
      
      <% if (trip.preferences) { %>
        <div style="margin-top: 20px;">
          <div class="info-label">旅遊偏好</div>
          <div class="info-value" style="background: #f7fafc; padding: 15px; border-radius: 8px; margin-top: 5px;">
            <%= trip.preferences %>
          </div>
        </div>
      <% } %>
      
      <div style="margin-top: 25px; text-align: center;">
        <% if (trip.status === 'pending') { %>
          <button onclick="triggerSearch()" class="btn">
            <i class="fas fa-search"></i> 手動觸發搜索
          </button>
        <% } %>
        <a href="/" class="btn btn-secondary">
          <i class="fas fa-home"></i> 返回首頁
        </a>
      </div>
    </div>

    <div class="grid">
      <!-- 航班信息 -->
      <div class="card">
        <div class="section-title">
          <i class="fas fa-plane"></i>
          航班信息
        </div>
        <% if (flights && flights.length > 0) { %>
          <% flights.forEach(function(flight) { %>
            <div class="flight-item">
              <div style="display: flex; justify-content: between; align-items: center; margin-bottom: 10px;">
                <h4><%= flight.airline %> <%= flight.flight_number %></h4>
                <div class="price">$<%= flight.price %></div>
              </div>
              <p><strong>出發：</strong><%= flight.origin %> → <%= flight.destination %></p>
              <p><strong>日期：</strong><%= moment(flight.departure_date).format('YYYY-MM-DD') %></p>
              <% if (flight.return_date) { %>
                <p><strong>回程：</strong><%= moment(flight.return_date).format('YYYY-MM-DD') %></p>
              <% } %>
              <% if (flight.booking_url) { %>
                <p><a href="<%= flight.booking_url %>" target="_blank" class="btn" style="margin-top: 10px; font-size: 0.9rem; padding: 8px 16px;">
                  <i class="fas fa-external-link-alt"></i> 查看預訂
                </a></p>
              <% } %>
            </div>
          <% }); %>
        <% } else { %>
          <div class="no-data">
            <i class="fas fa-plane-slash"></i>
            <p>暫無航班信息</p>
          </div>
        <% } %>
      </div>

      <!-- 酒店信息 -->
      <div class="card">
        <div class="section-title">
          <i class="fas fa-hotel"></i>
          酒店信息
        </div>
        <% if (hotels && hotels.length > 0) { %>
          <% hotels.forEach(function(hotel) { %>
            <div class="hotel-item">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h4><%= hotel.hotel_name %></h4>
                <% if (hotel.price_per_night) { %>
                  <div class="price">$<%= hotel.price_per_night %>/晚</div>
                <% } %>
              </div>
              <% if (hotel.rating) { %>
                <div class="rating">
                  <% for (let i = 0; i < Math.floor(hotel.rating); i++) { %>
                    <i class="fas fa-star"></i>
                  <% } %>
                  <% if (hotel.rating % 1 !== 0) { %>
                    <i class="fas fa-star-half-alt"></i>
                  <% } %>
                  <span>(<%= hotel.rating %>)</span>
                </div>
              <% } %>
              <p><strong>入住：</strong><%= moment(hotel.check_in_date).format('YYYY-MM-DD') %></p>
              <p><strong>退房：</strong><%= moment(hotel.check_out_date).format('YYYY-MM-DD') %></p>
              <% if (hotel.phone) { %>
                <p><strong>電話：</strong><%= hotel.phone %></p>
              <% } %>
              <% if (hotel.website) { %>
                <p><a href="<%= hotel.website %>" target="_blank" class="btn" style="margin-top: 10px; font-size: 0.9rem; padding: 8px 16px;">
                  <i class="fas fa-external-link-alt"></i> 查看詳情
                </a></p>
              <% } %>
            </div>
          <% }); %>
        <% } else { %>
          <div class="no-data">
            <i class="fas fa-bed"></i>
            <p>暫無酒店信息</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 旅遊攻略 -->
    <% if (report && report.travel_guides) { %>
      <div class="card">
        <div class="section-title">
          <i class="fas fa-map"></i>
          AI 旅遊攻略
        </div>
        <div class="travel-guide">
          <%= report.travel_guides %>
        </div>
      </div>
    <% } %>
  </div>

  <script>
    async function triggerSearch() {
      const button = event.target;
      const originalText = button.innerHTML;
      
      button.disabled = true;
      button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 搜索中...';
      
      try {
        const response = await fetch(`/trips/<%= trip.id %>/search`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert('搜索完成！報告已發送到您的郵箱。');
          location.reload();
        } else {
          alert('搜索失敗：' + result.error);
        }
      } catch (error) {
        alert('搜索過程中發生錯誤：' + error.message);
      } finally {
        button.disabled = false;
        button.innerHTML = originalText;
      }
    }
  </script>
</body>
</html>