<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { 
      font-family: 'Noto Sans TC', sans-serif; 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      color: #2d3748;
    }
    
    .container { 
      max-width: 1000px; 
      margin: 0 auto; 
      padding: 20px; 
    }
    
    .header {
      text-align: center;
      color: white;
      margin-bottom: 40px;
      padding: 40px 0;
    }
    
    .header h1 { 
      font-size: 3.5rem; 
      font-weight: 700;
      margin-bottom: 10px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }
    
    .header .subtitle {
      font-size: 1.3rem;
      opacity: 0.9;
      font-weight: 400;
    }
    
    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }
    
    .feature {
      background: rgba(255,255,255,0.95);
      padding: 25px;
      border-radius: 15px;
      text-align: center;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    }
    
    .feature i {
      font-size: 2.5rem;
      color: #667eea;
      margin-bottom: 15px;
    }
    
    .feature h3 {
      font-size: 1.2rem;
      margin-bottom: 10px;
      color: #2d3748;
    }
    
    .feature p {
      color: #718096;
      font-size: 0.95rem;
    }
    
    .card { 
      background: rgba(255,255,255,0.95); 
      border-radius: 20px; 
      padding: 40px; 
      box-shadow: 0 20px 60px rgba(0,0,0,0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.3);
    }
    
    .card h2 {
      font-size: 2rem;
      margin-bottom: 30px;
      text-align: center;
      color: #2d3748;
      font-weight: 600;
    }
    
    label { 
      display: block; 
      font-weight: 600; 
      margin: 20px 0 8px;
      color: #4a5568;
      font-size: 1rem;
    }
    
    input, select, textarea { 
      width: 100%; 
      padding: 15px 18px; 
      border: 2px solid #e2e8f0; 
      border-radius: 12px;
      font-size: 1rem;
      transition: all 0.3s ease;
      background: white;
    }
    
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    
    .grid { 
      display: grid; 
      grid-template-columns: 1fr 1fr; 
      gap: 20px; 
    }
    
    .grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
    }
    
    textarea {
      min-height: 100px;
      resize: vertical;
    }
    
    .actions { 
      text-align: center; 
      margin-top: 30px; 
    }
    
    button { 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white; 
      border: none; 
      padding: 18px 40px; 
      border-radius: 12px; 
      cursor: pointer; 
      font-weight: 600;
      font-size: 1.1rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }
    
    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
    }
    
    .error { 
      color: #e53e3e; 
      background: #fed7d7;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-weight: 500;
    }
    
    .footer { 
      margin-top: 50px; 
      color: rgba(255,255,255,0.8); 
      font-size: 1rem; 
      text-align: center;
      padding: 30px;
      background: rgba(255,255,255,0.1);
      border-radius: 15px;
      backdrop-filter: blur(10px);
    }
    
    .footer i {
      color: #ffd700;
      margin: 0 5px;
    }
    
    @media (max-width: 768px) {
      .grid, .grid-3 { 
        grid-template-columns: 1fr; 
      }
      
      .header h1 {
        font-size: 2.5rem;
      }
      
      .card {
        padding: 25px;
      }
      
      .container {
        padding: 15px;
      }
    }
  </style>
  <% if (typeof error !== 'undefined') { %>
  <meta name="robots" content="noindex">
  <% } %>
  <script>
    function ensureMinDate() {
      const input = document.getElementById('startDate');
      const today = new Date();
      const iso = new Date(today.getTime() + 24*3600*1000).toISOString().slice(0,10);
      input.min = iso;
    }
    window.addEventListener('DOMContentLoaded', ensureMinDate);
  </script>
  </head>
<body>
  <div class="container">
    <div class="header">
      <h1><i class="fas fa-plane-departure"></i> 旅遊易</h1>
      <p class="subtitle"><%= typeof subtitle !== 'undefined' ? subtitle : '您的專屬AI旅遊助理' %></p>
    </div>

    <!-- 功能特色 -->
    <div class="features">
      <div class="feature">
        <i class="fas fa-robot"></i>
        <h3>AI 智能推薦</h3>
        <p>運用人工智能分析，為您推薦最適合的旅遊方案</p>
      </div>
      <div class="feature">
        <i class="fas fa-plane"></i>
        <h3>航班比價</h3>
        <p>自動搜尋最優惠的航班價格，省時省錢</p>
      </div>
      <div class="feature">
        <i class="fas fa-hotel"></i>
        <h3>酒店精選</h3>
        <p>精選優質酒店，提供詳細資訊和聯絡方式</p>
      </div>
      <div class="feature">
        <i class="fas fa-cloud-sun"></i>
        <h3>天氣預報</h3>
        <p>即時天氣資訊，助您準備合適的旅行裝備</p>
      </div>
    </div>

    <div class="card">
      <h2><i class="fas fa-map-marked-alt"></i> 規劃您的完美旅程</h2>
      <% if (typeof error !== 'undefined') { %>
        <div class="error">
          <i class="fas fa-exclamation-triangle"></i> <%= error %>
        </div>
      <% } %>
      
      <form method="POST" action="/trips">
        <div class="grid">
          <div>
            <label for="name"><i class="fas fa-user"></i> 姓名</label>
            <input id="name" name="name" placeholder="請輸入您的姓名" required />
          </div>
          <div>
            <label for="email"><i class="fas fa-envelope"></i> 電子郵箱</label>
            <input id="email" name="email" type="email" placeholder="your@email.com" required />
          </div>
        </div>

        <label for="destination"><i class="fas fa-map-marker-alt"></i> 旅遊目的地</label>
        <select id="destination" name="destination" required>
          <option value="">請選擇您的目的地</option>
          <option value="東京">🇯🇵 東京</option>
          <option value="大阪">🇯🇵 大阪</option>
          <option value="首爾">🇰🇷 首爾</option>
          <option value="曼谷">🇹🇭 曼谷</option>
          <option value="新加坡">🇸🇬 新加坡</option>
          <option value="吉隆坡">🇲🇾 吉隆坡</option>
          <option value="香港">🇭🇰 香港</option>
          <option value="上海">🇨🇳 上海</option>
          <option value="北京">🇨🇳 北京</option>
        </select>

        <div class="grid-3">
          <div>
            <label for="startDate"><i class="fas fa-calendar-alt"></i> 出發日期</label>
            <input id="startDate" name="startDate" type="date" required />
          </div>
          <div>
            <label for="duration"><i class="fas fa-clock"></i> 旅行天數</label>
            <input id="duration" name="duration" type="number" min="1" max="30" value="7" placeholder="天數" required />
          </div>
          <div>
            <label for="travelers"><i class="fas fa-users"></i> 旅行人數</label>
            <input id="travelers" name="travelers" type="number" min="1" max="10" value="1" placeholder="人數" />
          </div>
        </div>

        <label for="budget"><i class="fas fa-dollar-sign"></i> 預算範圍（可選）</label>
        <input id="budget" name="budget" type="number" min="0" step="100" placeholder="預算金額（台幣）" />

        <label for="preferences"><i class="fas fa-heart"></i> 旅遊偏好（可選）</label>
        <textarea id="preferences" name="preferences" placeholder="請描述您的旅遊偏好，例如：喜歡歷史文化、美食探索、購物娛樂、自然風光等..." rows="3"></textarea>

        <div class="actions">
          <button type="submit">
            <i class="fas fa-paper-plane"></i> 開始規劃我的旅程
          </button>
        </div>
      </form>
    </div>

    <div class="footer">
      <p>
        <i class="fas fa-magic"></i> 
        我們將在您出發前三天自動搜集最新的航班、酒店、天氣和旅遊資訊
        <i class="fas fa-magic"></i>
      </p>
      <p>
        <i class="fas fa-envelope"></i> 
        完整的旅遊攻略將直接發送到您的電子郵箱
        <i class="fas fa-heart"></i>
      </p>
    </div>
  </div>
</body>
</html>

