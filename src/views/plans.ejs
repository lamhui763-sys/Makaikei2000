<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .container {
            padding: 40px 0;
        }
        
        .page-header {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            text-align: center;
            color: white;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }
        
        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }
        
        .plan-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .plan-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }
        
        .plan-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .plan-destination {
            font-size: 1.5rem;
            font-weight: 700;
            color: #667eea;
        }
        
        .plan-status {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }
        
        .status-pending {
            background: #fff3cd;
            color: #856404;
        }
        
        .status-completed {
            background: #d1edff;
            color: #0c5460;
        }
        
        .plan-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .info-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .info-icon {
            color: #667eea;
            font-size: 1.2rem;
        }
        
        .plan-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .btn {
            border-radius: 25px;
            padding: 8px 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
        }
        
        .btn-outline-primary {
            border-color: #667eea;
            color: #667eea;
        }
        
        .btn-outline-primary:hover {
            background: #667eea;
            border-color: #667eea;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: white;
        }
        
        .empty-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.7;
        }
        
        .create-btn {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            padding: 15px 30px;
            font-size: 1.1rem;
            border-radius: 50px;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }
        
        .create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
            color: white;
        }
        
        .alert {
            border-radius: 15px;
            border: none;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-list"></i> 旅遊計劃列表
            </h1>
            <p>管理您的所有旅遊計劃和查看詳細信息</p>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (plans && plans.length > 0) { %>
            <div class="row">
                <% plans.forEach(function(plan) { %>
                    <div class="col-lg-6 col-xl-4">
                        <div class="plan-card">
                            <div class="plan-header">
                                <div class="plan-destination">
                                    <i class="fas fa-map-marker-alt"></i> <%= plan.destination %>
                                </div>
                                <span class="plan-status status-<%= plan.status %>">
                                    <% if (plan.status === 'pending') { %>
                                        <i class="fas fa-clock"></i> 處理中
                                    <% } else { %>
                                        <i class="fas fa-check"></i> 已完成
                                    <% } %>
                                </span>
                            </div>
                            
                            <div class="plan-info">
                                <div class="info-item">
                                    <i class="fas fa-user info-icon"></i>
                                    <span><%= plan.user_name %></span>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-calendar info-icon"></i>
                                    <span><%= new Date(plan.start_date).toLocaleDateString('zh-TW') %></span>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-clock info-icon"></i>
                                    <span><%= plan.duration %> 天</span>
                                </div>
                                <div class="info-item">
                                    <i class="fas fa-envelope info-icon"></i>
                                    <span><%= plan.user_email %></span>
                                </div>
                            </div>
                            
                            <div class="plan-actions">
                                <a href="/plan/<%= plan.id %>" class="btn btn-primary">
                                    <i class="fas fa-eye"></i> 查看詳情
                                </a>
                                <% if (plan.status === 'completed') { %>
                                    <button class="btn btn-outline-primary" onclick="sendReport(<%= plan.id %>)">
                                        <i class="fas fa-paper-plane"></i> 重新發送報告
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-plane"></i>
                </div>
                <h3>還沒有旅遊計劃</h3>
                <p>開始創建您的第一個旅遊計劃吧！</p>
                <a href="/create" class="create-btn">
                    <i class="fas fa-plus"></i> 創建旅遊計劃
                </a>
            </div>
        <% } %>
        
        <div class="text-center mt-4">
            <a href="/" class="btn btn-outline-light">
                <i class="fas fa-arrow-left"></i> 返回首頁
            </a>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function sendReport(planId) {
            if (!confirm('確定要重新發送旅遊報告嗎？')) {
                return;
            }
            
            try {
                const response = await fetch(`/api/travel-plans/${planId}/send-report`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert('旅遊報告已重新發送！');
                } else {
                    alert('發送失敗：' + result.message);
                }
            } catch (error) {
                alert('發送旅遊報告失敗，請稍後再試');
                console.error('Error:', error);
            }
        }
    </script>
</body>
</html>